# Local demo works with no keys. Set these to use Azure OpenAI for the synthesizer.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional: point the ServiceNow adapter at a real instance instead of the local store.
SERVICENOW_INSTANCE=
SERVICENOW_USER=
SERVICENOW_PASSWORD=

DATABASE_URL=sqlite:///./signaldesk.db
